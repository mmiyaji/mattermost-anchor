{
  "manifest_version": 3,
  "name": "Mattermost Anchor",
  "version": "0.1.0",
  "description": "Pin one sidebar category above Unreads in Mattermost.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Mattermost Anchor settings" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
